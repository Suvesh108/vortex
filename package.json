{
  "name": "vortexdownloader",
  "private": true,
  "version": "0.2.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently \"npm run dev:vite\" \"npm run dev:server\"",
    "dev:vite": "cd frontend && npx vite --port=3000 --host=0.0.0.0",
    "dev:server": "cd backend && tsx server.ts",
    "server": "cd backend && tsx server.ts",
    "start": "cd backend && tsx server.ts",
    "build": "cd frontend && npx vite build",
    "preview": "cd frontend && npx vite preview",
    "clean": "rm -rf frontend/dist backend/server.js",
    "lint": "cd frontend && tsc --noEmit",
    "generate:icons": "node scripts/generate-icons.js",
    "cap:sync": "npx cap sync android",
    "build:apk": "node scripts/generate-icons.js && npm run build && npx cap sync android"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.0",
    "@capacitor/core": "^8.5.0",
    "@capacitor/filesystem": "^8.1.3",
    "@capacitor/local-notifications": "^8.3.1",
    "@google/genai": "^2.4.0",
    "@tailwindcss/vite": "^4.1.14",
    "@vitejs/plugin-react": "^5.0.4",
    "cors": "^2.8.6",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "vite": "^6.2.3"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.5.0",
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.21",
    "@types/node": "^22.14.0",
    "autoprefixer": "^10.4.21",
    "concurrently": "^10.0.3",
    "esbuild": "^0.25.0",
    "sharp": "^0.35.1",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.3"
  }
}
